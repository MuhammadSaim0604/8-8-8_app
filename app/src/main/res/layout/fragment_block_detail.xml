<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="160dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                style="@style/CardStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="72dp"
                android:layout_marginBottom="20dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvHeroEmoji"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:gravity="center"
                        android:textSize="30sp"
                        android:background="@drawable/bg_circle_dark"
                        tools:text="💼"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvHeroName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:layout_marginStart="14dp"
                        tools:text="Work"
                        app:layout_constraintStart_toEndOf="@id/tvHeroEmoji"
                        app:layout_constraintTop_toTopOf="@id/tvHeroEmoji"
                        app:layout_constraintEnd_toStartOf="@id/heroRing" />

                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="2dp"
                        tools:text="Work &amp; Learning"
                        app:layout_constraintStart_toEndOf="@id/tvHeroEmoji"
                        app:layout_constraintTop_toBottomOf="@id/tvHeroName"
                        app:layout_constraintEnd_toStartOf="@id/heroRing" />

                    <com.dayblocks.app.ui.common.CircularProgressView
                        android:id="@+id/heroRing"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Stats below -->
                    <LinearLayout
                        android:id="@+id/llHeroStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp"
                        app:layout_constraintTop_toBottomOf="@id/tvHeroEmoji"
                        app:layout_constraintStart_toStartOf="parent">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvHeroUsed"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="16sp" android:textColor="@color/text_primary"
                                android:textStyle="bold" tools:text="4h 30m" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Used" android:textSize="11sp" android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="32dp"
                            android:background="@color/divider" />

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:id="@+id/tvHeroFree"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="16sp" android:textColor="@color/text_primary"
                                android:textStyle="bold" tools:text="3h 30m" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Free" android:textSize="11sp" android:textColor="@color/text_muted" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="32dp"
                            android:background="@color/divider" />

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="8h" android:textSize="16sp" android:textColor="@color/text_primary"
                                android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Total" android:textSize="11sp" android:textColor="@color/text_muted" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Capacity bar -->
                    <LinearLayout
                        android:id="@+id/llCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/llHeroStats"
                        app:layout_constraintStart_toStartOf="parent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:background="@color/track"
                            android:layout_marginBottom="6dp">

                            <View
                                android:id="@+id/vCapacityFill"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:background="@color/accent_blue" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:id="@+id/tvCapacityBadge"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp" android:textColor="@color/text_muted"
                                tools:text="120m remaining" />
                            <TextView android:id="@+id/tvCapacityPercent"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="12sp" android:textColor="@color/text_muted"
                                tools:text="56%" />
                        </LinearLayout>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tasks Section header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView android:id="@+id/tvTasksSectionTitle"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp" android:textColor="@color/text_primary"
                    android:textStyle="bold" tools:text="Tasks (3)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddTask"
                    style="@style/ButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ Add Task"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Tasks list -->
            <LinearLayout
                android:id="@+id/llTasksList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/llDetailEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="No tasks yet" android:textSize="16sp"
                    android:textColor="@color/text_muted" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddFirstTask"
                    style="@style/ButtonStyle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Add First Task" android:layout_marginTop="16dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Toolbar overlay -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingTop="24dp"
        android:background="@color/background" />

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:layout_marginBottom="80dp"
        app:backgroundTint="@color/accent_blue"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/text_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
