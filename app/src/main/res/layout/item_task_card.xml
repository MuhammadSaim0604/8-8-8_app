<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="false"
    app:cardBackgroundColor="@color/card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main content row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <!-- Left accent bar -->
            <View
                android:id="@+id/vAccentBar"
                android:layout_width="3dp"
                android:layout_height="42dp"
                android:background="@color/accent_blue"
                android:layout_marginEnd="12dp" />

            <!-- Task info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Name row with pulsing dot -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/vPulseDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_circle_blue"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvTaskName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Deep Work" />
                </LinearLayout>

                <!-- Duration chip -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        tools:text="⏱ 2h 00m" />

                    <TextView
                        android:id="@+id/tvElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/accent_blue"
                        android:layout_marginStart="8dp"
                        android:visibility="gone"
                        tools:text="45:30" />
                </LinearLayout>

            </LinearLayout>

            <!-- Edit button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:icon="@drawable/ic_edit"
                app:iconTint="@color/text_muted"
                app:iconSize="18dp" />

            <!-- Delete button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/text_muted"
                app:iconSize="18dp" />

            <!-- Play/Pause button -->
            <FrameLayout
                android:id="@+id/btnPlayPause"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_play"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="4dp">

                <ImageView
                    android:id="@+id/ivPlayPauseIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    android:tint="@color/text_primary" />
            </FrameLayout>

        </LinearLayout>

        <!-- Progress bar container -->
        <FrameLayout
            android:id="@+id/flProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:background="@color/track"
            android:visibility="gone">
            <View
                android:id="@+id/vTaskProgress"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="@color/accent_blue" />
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
