<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed notification — mirrors the compact single-row style of the expanded blocks.
  Single row:  [emoji] [task name (flex)]  [block · elapsed]  [▶] [■]
  Bottom:       thin 3dp progress bar (hidden when idle)
  Max height for collapsed: ~64dp
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Main content row — same compact style as the expanded block rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <!-- Block emoji (large, anchors identity) -->
        <TextView
            android:id="@+id/tvCollapsedEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱"
            android:textSize="18sp"
            android:layout_marginEnd="8dp" />

        <!-- Task name + status stacked vertically, takes all remaining space -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvCollapsedTaskName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DayBlocks"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvCollapsedStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8-8-8 Dashboard · Tap to open"
                android:textColor="#9CA3AF"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Play/Pause -->
        <ImageView
            android:id="@+id/btnCollapsedPlayPause"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_play"
            android:contentDescription="Play/Pause"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp" />

        <!-- Stop -->
        <ImageView
            android:id="@+id/btnCollapsedStop"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_stop"
            android:contentDescription="Stop"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Thin block-colour progress bar — only shown when a task is active -->
    <ProgressBar
        android:id="@+id/pbCollapsed"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone"
        android:progressDrawable="@drawable/bg_progress_work" />

</LinearLayout>
