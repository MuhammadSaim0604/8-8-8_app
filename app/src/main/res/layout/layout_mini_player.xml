<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/miniPlayerCard"
    style="@style/CardStyle"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_elevated"
    app:strokeColor="@color/accent_blue"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top progress track + fill -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/track">
            <View
                android:id="@+id/miniPlayerProgress"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:background="@color/accent_blue" />
        </FrameLayout>

        <!-- Content row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <!-- Left color dot -->
            <View
                android:id="@+id/miniDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle_blue"
                android:layout_marginEnd="10dp" />

            <!-- Task info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMiniTaskName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Deep Work" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvMiniBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        tools:text="Work" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" · "
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvMiniElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/accent_blue"
                        tools:text="12:34" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pause/Resume button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMiniPause"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="0dp"
                app:icon="@drawable/ic_pause"
                app:iconTint="@color/accent_blue"
                app:iconSize="22dp" />

            <!-- Stop button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMiniStop"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="0dp"
                app:icon="@drawable/ic_stop"
                app:iconTint="@color/danger"
                app:iconSize="22dp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
